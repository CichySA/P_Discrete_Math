\usepackage{hyperref}
\newcommand*{\figref}[2][]{%
  \hyperref[{fig:#2}]{%
    \textcolor{centrale_red}{{Figure~\ref*{fig:#2}}}%
    \ifx\\#1\\%
    \else
      \,#1%
    \fi
  }%
}
\newcommand*{\tableref}[2][]{%
  \hyperref[{tab:#2}]{%
    \textcolor{centrale_red}{{Table ~\ref*{tab:#2}}}%
    \ifx\\#1\\%
    \else
      \,#1%
    \fi
  }%
}


\newcommand*{\mylistref}[2][]{%
  \hyperref[lst:#2]{%
    \textcolor{centrale_red}{Listing~\ref*{lst:#2}}%
    \ifx\\#1\\%
    \else
      \,#1%
    \fi
  }%
}

