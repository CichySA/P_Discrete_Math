% --- ENVIRONNEMENT DÉDIÉ codeMatlab ---
\lstnewenvironment{codeMatlab}[1][]{
    \lstset{
        language=Matlab,
        backgroundcolor=\color{mlbackground},   
        commentstyle=\color{mlgreen},
        keywordstyle=\color{mlmainblue},
        stringstyle=\color{mlpurple},
        % On garde la taille de police 10.5pt pour l'harmonie avec FreeFEM
        basicstyle=\ttfamily\fontsize{10.5pt}{13pt}\selectfont, 
        breakatwhitespace=false,         
        breaklines=true,                 
        captionpos=b,                    
        keepspaces=true,                 
        numbers=left,                    
        numbersep=5pt,
        numberstyle=\tiny\color{gray},                  
        showspaces=false,                
        showstringspaces=false,
        tabsize=4,
        % Réutilisation de votre bloc literate pour les accents
        literate=%
        {é}{{\'e}}{1}{è}{{\`e}}{1}{à}{{\`a}}{1}{ç}{{\c{c}}}{1}{ù}{{\`u}}{1}
        {É}{{\'E}}{1}{È}{{\`E}}{1}{À}{{\`A}}{1}{ê}{{\^e}}{1}{î}{{\^i}}{1}
        {ô}{{\^o}}{1}{û}{{\^u}}{1}{â}{{\^a}}{1},
        #1 
    }
}{}

